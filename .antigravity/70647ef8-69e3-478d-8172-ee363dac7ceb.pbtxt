  file_change {
    absolute_path_uri: "file:///src/components/ResponsibleGambling.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { HeartPulse, Clock, Euro, ShieldBan } from \"lucide-react\";\n\nexport function ResponsibleGambling() {\n  return (\n    <section className=\"bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 md:p-8\">\n      <div className=\"flex items-center gap-3 mb-6\">\n        <div className=\"bg-rose-500/10 border border-rose-500/20 p-2 rounded-lg text-rose-400\">\n          <HeartPulse size={20} />\n        </div>\n        <h2 className=\"text-sm font-bold text-rose-400 uppercase tracking-wider\">Responsible Gambling Tools</h2>\n      </div>\n\n      <p className=\"text-xs text-slate-300 mb-6 leading-relaxed\">\n        In compliance with the KSA regulations, Casino777.nl provides a robust suite of mandatory tools designed to keep gambling safe and manageable. Upon registration, users are required to set strict limits.\n      </p>\n\n      <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <Euro size={16} className=\"text-emerald-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Deposit Limits</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Players must set daily, weekly, or monthly deposit ceilings. Decreasing limits takes immediate effect, while increasing them requires a 7-day cooldown period.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <Clock size={16} className=\"text-blue-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Reality Checks & Session Limits</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Time limits must be defined per session. In-game popups appear periodically to remind players of the time elapsed and net losses.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <Euro size={16} className=\"text-amber-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Balance Limits</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            A maximum wallet balance limit forces automatic withdrawals back to the verified iDEAL bank account if the threshold is exceeded.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-rose-500/20 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <ShieldBan size={16} className=\"text-rose-400\" />\n            <h3 className=\"text-xs font-bold text-white\">CRUKS Integration</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Fully integrated with the Centraal Register Uitsluiting Kansspelen. Players registered on CRUKS are automatically blocked from accessing the site.\n          </p>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
