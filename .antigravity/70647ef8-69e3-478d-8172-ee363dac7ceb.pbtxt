    replacement_chunks {
      replacement_content: "import { Gamepad2, PlaySquare, Dice5, UserRound } from \"lucide-react\";\n\nexport function GameVariety() {\n  return (\n    <section className=\"bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 md:p-8\">\n      <div className=\"flex items-center gap-3 mb-6\">\n        <div className=\"bg-emerald-500/10 border border-emerald-500/20 p-2 rounded-lg text-emerald-400\">\n          <Gamepad2 size={20} />\n        </div>\n        <h2 className=\"text-sm font-bold text-blue-400 uppercase tracking-wider\">Game Library & Variety</h2>\n      </div>\n      \n      <p className=\"text-xs text-slate-300 mb-6 leading-relaxed\">\n        With over 2,000 titles from leading software providers, the portfolio offers significant depth across major gaming categories.\n      </p>\n\n      <div className=\"grid sm:grid-cols-3 gap-4\">\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <PlaySquare size={16} className=\"text-indigo-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Video Slots</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed mb-3\">\n            The largest category featuring Megaways, classic 3-reels, and progressive jackpots.\n          </p>\n          <div className=\"text-[10px] text-slate-500 font-mono\">\n            Notable: Starburst, Gonzo\'s Quest, Book of Dead\n          </div>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <Dice5 size={16} className=\"text-amber-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Table Games</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed mb-3\">\n            A solid selection of RNG-based traditional casino games including high-limit variants.\