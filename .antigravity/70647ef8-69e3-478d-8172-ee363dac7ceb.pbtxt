lassName=\"p-4 text-slate-400 text-xs\">BTC, ETH, USDT</td>\n              <td className=\"p-4 text-emerald-400 font-medium\">Instant</td>\n              <td className=\"p-4 text-emerald-400 font-medium\">0 - 24 Hours</td>\n              <td className=\"p-4 text-slate-400 text-xs\">Network Only</td>\n            </tr>\n            <tr className=\"border-b border-white/5\">\n              <td className=\"p-4 text-white font-medium flex items-center gap-2\">\n                <CreditCard size={16} className=\"text-blue-400\" /> Credit/Debit\n              </td>\n              <td className=\"p-4 text-slate-400 text-xs\">Visa, Mastercard</td>\n              <td className=\"p-4 text-emerald-400 font-medium\">Instant</td>\n              <td className=\"p-4 text-slate-400 font-medium\">2 - 5 Biz Days</td>\n              <td className=\"p-4 text-slate-400 text-xs\">None</td>\n            </tr>\n            <tr>\n              <td className=\"p-4 text-white font-medium flex items-center gap-2\">\n                <Wallet size={16} className=\"text-indigo-400\" /> E-Wallets\n              </td>\n              <td className=\"p-4 text-slate-400 text-xs\">Skrill, Neteller</td>\n              <td className=\"p-4 text-emerald-400 font-medium\">Instant</td>\n              <td className=\"p-4 text-emerald-400 font-medium\">0 - 48 Hours</td>\n              <td className=\"p-4 text-slate-400 text-xs\">None</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n  );\n}\n"
