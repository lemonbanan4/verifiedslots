      replacement_content: "        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-5\">\n          <h3 className=\"text-sm font-bold text-white mb-2\">How long does account verification (iDIN) take?</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Identity verification is processed instantly using iDIN, which links directly to your Dutch bank account. This seamless process eliminates the need to upload manual utility bills or passports, ensuring compliance with KSA regulations instantly.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-5\">\n          <h3 className=\"text-sm font-bold text-white mb-2\">Why was my deposit blocked?</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Deposits may be blocked if you attempt to use an unverified payment method, or if you exceed the deposit limits you set during registration. Additionally, if you are actively registered in the CRUKS database, all deposits and gameplay will be restricted.\n          </p>\n        </div>"
