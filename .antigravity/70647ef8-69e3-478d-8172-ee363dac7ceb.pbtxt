  file_change {
    absolute_path_uri: "file:///src/components/ResponsibleGambling.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      <p className=\"text-xs text-slate-300 mb-6 leading-relaxed\">\n        Because Winbeast operates outside of standard European regulatory frameworks, its responsible gambling tools are minimal and not mandatory upon registration. Players must manually seek out these options.\n      </p>\n\n      <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <Euro size={16} className=\"text-emerald-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Deposit Limits</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Players can set optional daily, weekly, or monthly deposit ceilings by contacting customer support. These are not enforced via the user dashboard.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <Clock size={16} className=\"text-blue-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Reality Checks</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            There are no automated reality check popups or session timers provided by the platform. Players must monitor their own session duration.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <ShieldBan size={16} className=\"text-amber-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Self-Exclusion</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Users can request a self-exclusion period (from 24 hours up to a year) by emailing support, though enforcement across sister sites is not guaranteed.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-rose-500/20 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <ShieldBan size={16} className=\"text-rose-400\" />\n            <h3 className=\"text-xs font-bold text-white\">No CRUKS Integration</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            As an offshore site, Winbeast is completely circumventing the Dutch Centraal Register Uitsluiting Kansspelen. Blocked players can still register and play here.\n          </p>\n        </div>"
      replacement_content: "      <p className=\"text-xs text-slate-300 mb-6 leading-relaxed\">\n        Because Bitz Casino operates outside of standard European regulatory frameworks, its responsible gambling tools are minimal and not mandatory upon registration. Players must manually seek out these options, and they are not strictly enforced.\n      </p>\n\n      <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <Euro size={16} className=\"text-emerald-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Deposit Limits</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Players can request optional daily, weekly, or monthly deposit limits by contacting customer support. These are not easily configured via the user dashboard.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <Clock size={16} className=\"text-blue-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Reality Checks</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            There are no automated reality check popups or session timers provided by the platform. Players must monitor their own session duration and losses manually.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <ShieldBan size={16} className=\"text-amber-400\" />\n            <h3 className=\"text-xs font-bold text-white\">Self-Exclusion</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Users can request a self-exclusion period by emailing support, though enforcement is manual and players can often bypass it easily.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-rose-500/20 rounded-xl p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <ShieldBan size={16} className=\"text-rose-400\" />\n            <h3 className=\"text-xs font-bold text-white\">No CRUKS Integration</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            As an offshore site, Bitz.io completely bypasses the Dutch Centraal Register Uitsluiting Kansspelen. Blocked vulnerable players can still register and play here.\n          </p>\n        </div>"
    }
