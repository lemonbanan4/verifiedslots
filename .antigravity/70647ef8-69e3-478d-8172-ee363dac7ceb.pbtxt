      replacement_content: "        <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-rose-500/10 border border-rose-500/20 rounded-full mb-4\">\n          <div className=\"w-2 h-2 bg-rose-500 rounded-full animate-pulse\"></div>\n          <span className=\"text-[10px] font-bold text-rose-400 uppercase tracking-tighter\">Proceed with Caution</span>\n        </div>\n        <h2 className=\"text-xl font-bold text-white mb-3 tracking-tight\">Trust & Safety Profile</h2>\n        <p className=\"text-sm text-slate-300 leading-relaxed\">\n          When evaluating an online operator, security and regulatory compliance are our primary metrics. Winbeast currently operates without a KSA license, meaning Dutch players are entirely unprotected by local gaming authorities.\n        </p>"
    }
    replacement_chunks {
      target_content: "        <div className=\"p-4 bg-slate-900/50 rounded-2xl border border-white/5\">\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Shield className=\"text-blue-400\" size={16} />\n            <h3 className=\"text-xs font-bold text-slate-200 uppercase tracking-widest\">Kansspelautoriteit (KSA) License</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            The operator holds a valid Dutch KSA license. This is one of the strictest regulatory bodies in Europe, ensuring full compliance with local laws, mandatory CRUKS integration, and guaranteed payout security.\n          </p>\n        </div>\n\n        <div className=\"p-4 bg-slate-900/50 rounded-2xl border border-white/5\">\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Zap className=\"text-amber-400\" size={16} />\n            <h3 className=\"text-xs font-bold text-slate-200 uppercase tracking-widest\">iDEAL & Verification</h3>\n          </div>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Identity verification is conducted instantly via iDIN during registration. Payments are processed securely via iDEAL, with most withdrawals reaching Dutch bank accounts within 24 hours.\n          </p>\n        </div>"
