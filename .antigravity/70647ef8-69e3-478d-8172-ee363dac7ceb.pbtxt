    replacement_chunks {
      target_content: "export function Hero() {\n  return (\n    <section className=\"py-16 md:py-24 bg-slate-50 border-b border-slate-200\">\n      <div className=\"max-w-4xl mx-auto px-4 sm:px-6\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.5 }}\n          className=\"text-center\"\n        >\n          <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-100 text-blue-800 text-sm font-medium mb-6\">\n            <ShieldCheck size={16} />\n            Verified Review\n          </div>\n          <h1 className=\"text-4xl md:text-5xl font-display font-bold text-slate-900 mb-6\">\n            Apex Casino Review\n          </h1>\n          <p className=\"text-lg text-slate-600 mb-10 max-w-2xl mx-auto leading-relaxed\">\n            An objective, in-depth analysis of Apex Casino. We examine their 2000+ game library, bonus structures, and security protocols to help you make an informed decision.\n          </p>\n\n          <div className=\"flex flex-wrap justify-center gap-4\">\n            <div className=\"flex items-center gap-4 bg-white px-6 py-4 rounded-xl shadow-sm border border-slate-200 min-w-[240px]\">\n              <div className=\"bg-emerald-100 p-3 rounded-lg text-emerald-600\">\n                <Gift size={24} />\n              </div>\n              <div className=\"text-left\">\n                <p className=\"text-sm text-slate-500 font-medium\">Welcome Bonus</p>\n                <p className=\"font-bold text-slate-900 text-lg\">100% up to $500</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-4 bg-white px-6 py-4 rounded-xl shadow-sm border border-slate-200 min-w-[240px]\">\n              <div className=\"bg-indigo-100 p-3 rounded-lg text-indigo-600\">\n                <Gamepad2 size={24} />\n              </div>\n              <div className=\"text-left\">\n                <p className=\"text-sm text-slate-500 font-medium\">Game Library</p>\n                <p className=\"font-bold text-slate-900 text-lg\">2,000+ Titles</p>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n      </div>\n    </section>\n  );\n}"
      replacement_content: "export function Hero() {\n  return (\n    <section className=\"bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 md:p-12 relative overflow-hidden\">\n      <div className=\"max-w-4xl mx-auto relative z-10 text-center\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.5 }}\n        >\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-bold uppercase tracking-widest mb-6\">\n            <ShieldCheck size={14} />\n            Verified Review\n          </div>\n          <h1 className=\"text-4xl md:text-5xl font-display font-bold text-white mb-6 tracking-tight\">\n            Apex Casino <span className=\"text-blue-400 font-medium\">Review</span>\n          </h1>\n          <p className=\"text-sm md:text-base text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed\">\n            An objective, in-depth analysis of Apex Casino. We examine their 2000+ game library, bonus structures, and security protocols to help you make an informed decision.\n          </p>\n\n          <div className=\"flex flex-wrap justify-center gap-4\">\n            <div className=\"flex items-center gap-4 bg-white/5 border border-white/10 backdrop-blur-sm px-6 py-4 rounded-xl min-w-[240px]\">\n              <div className=\"bg-emerald-500/10 border border-emerald-500/20 p-3 rounded-lg text-emerald-400\">\n                <Gift size={24} />\n              </div>\n              <div className=\"text-left\">\n                <p className=\"text-[10px] text-slate-400 uppercase tracking-widest font-medium\">Welcome Bonus</p>\n                <p className=\"font-bold text-white text-lg\">100% up to $500</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-4 bg-white/5 border border-white/10 backdrop-blur-sm px-6 py-4 rounded-xl min-w-[240px]\">\n              <div className=\"bg-indigo-500/10 border border-indigo-500/20 p-3 rounded-lg text-indigo-400\">\n                <Gamepad2 size={24} />\n              </div>\n              <div className=\"text-left\">\n                <p className=\"text-[10px] text-slate-400 uppercase tracking-widest font-medium\">Game Library</p>\n                <p className=\"font-bold text-white text-lg\">2,000+ Titles</p>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n      </div>\n    </section>\n  );\n}"
    }
