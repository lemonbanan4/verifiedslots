      replacement_content: "import { HelpCircle } from \"lucide-react\";\n\nexport function FAQ() {\n  return (\n    <section className=\"bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 md:p-8\">\n      <div className=\"flex items-center gap-3 mb-6\">\n        <div className=\"bg-purple-500/10 border border-purple-500/20 p-2 rounded-lg text-purple-400\">\n          <HelpCircle size={20} />\n        </div>\n        <h2 className=\"text-sm font-bold text-blue-400 uppercase tracking-wider\">Frequently Asked Questions</h2>\n      </div>\n\n      <div className=\"space-y-4\">\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-5\">\n          <h3 className=\"text-sm font-bold text-white mb-2\">How long does account verification (KYC) take?</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Standard KYC verification is typically completed within 24 hours of document submission. To avoid withdrawal delays, we strongly recommend completing this process immediately after registration by providing a valid government-issued ID and recent proof of address.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-5\">\n          <h3 className=\"text-sm font-bold text-white mb-2\">Why was my credit card deposit declined?</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Banks in certain jurisdictions occasionally block transactions to offshore gaming sites. If your Visa or Mastercard deposit fails, we suggest contacting your bank to authorize international transactions, or alternatively using one of the supported E-Wallets or Cryptocurrency options for seamless deposits.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-xl p-5\">\n          <h3 className=\"text-sm font-bold text-white mb-2\">Is customer support available 24/7?</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Yes. The live chat operates 24/7 and is the fastest way to resolve urgent issues, with an average response time of under 3 minutes. For more complex inquiries, email support is available and typically responds within 12-24 hours.\n          </p>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
